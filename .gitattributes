# di settings: Files: Eol pilih yg \n

# Output CSS Tailwind: tetap LF
src/output.css text eol=lf


# Source files: gunakan LF secara konsisten
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.svg text eol=lf
*.json text eol=lf

# Default: Git mendeteksi file text secara otomatis
# * text=auto
* text=auto eol=lf